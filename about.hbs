<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Ditox: third-party licences</title>
<style>
body { font: 15px/1.5 system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; }
pre { white-space: pre-wrap; background: #f4f4f5; padding: 1rem; border-radius: 6px; }
h3 { margin-top: 2.5rem; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>Ditox is built from these crates. Each keeps its own licence, given below.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
