{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ditox",
  "version": "0.1.0",
  "identifier": "dev.ditox.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ditox",
        "width": 420,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "backgroundColor": "#00000000"
      },
      {
        "label": "options",
        "title": "Options",
        "width": 420,
        "height": 320,
        "visible": false,
        "decorations": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
